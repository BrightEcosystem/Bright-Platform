NEXT_PUBLIC_APP_NAME=Bright Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (frontend/cliente — chaves públicas, seguras para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (backend apenas — NUNCA usar prefixo NEXT_PUBLIC_, nunca ler em código de cliente)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Conexão direta Postgres (uso no servidor e em ferramentas administrativas —
# nunca no navegador). DIRECT_URL é usado para migrations (sem pool de conexões);
# DATABASE_URL é usado pela aplicação em runtime (com pool, via PgBouncer/Supavisor).
DATABASE_URL=
DIRECT_URL=

# n8n
N8N_BASE_URL=
N8N_API_KEY=
